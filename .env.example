# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database
# Default: zero-configuration local SQLite
DATABASE_URL=sqlite:///./copilot.db
# Production example:
# DATABASE_URL=postgresql://user:password@localhost:5432/chargeback_copilot

# Dispute Provider Integration
# Options: mock | razorpay
DISPUTE_SOURCE=mock

# Razorpay Test Mode Credentials (Optional - leave empty for mock mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret_never_commit
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# AI / LLM Provider Configuration
# Options: fallback | claude | openai
LLM_PROVIDER=fallback
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Security
SECRET_KEY=dev-secret-key-change-in-production-random-bytes-32
